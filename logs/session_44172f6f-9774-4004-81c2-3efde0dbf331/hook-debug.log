          "+            conn = ServiceNowConnectionHandler(url, username, password)",
          "+            try:",
          "+                response = conn.get(",
          "+                    \"sys_dictionary\",",
          "+                    query=f\"name={customer_table}\",",
          "+                    limit=200",
